# --- Base de données -------------------------------------------------------
# Chaîne de connexion PostgreSQL. En production : instance hébergée en région UE
# (décision d'architecture n°2, voir docs/plombeo/PHASE-0-ARCHITECTURE.md).
DATABASE_URL="postgresql://user:password@localhost:5432/plombeo"

# --- Sessions --------------------------------------------------------------
# Secret de signature des cookies de session (HS256).
# Générer une valeur aléatoire d'au moins 32 caractères, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NE JAMAIS committer la valeur réelle.
SESSION_SECRET="change-me-in-production"

# --- Application -----------------------------------------------------------
# Base des liens absolus générés par l'application.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Stockage des fichiers (Phase 6) ---------------------------------------
# Emplacement des pièces versées (photos, PDF, attestations).
# Sans l'une de ces variables, l'envoi de fichiers est REFUSÉ avec un message
# clair : jamais de fichier accepté puis silencieusement perdu (§76).
#
# Disque persistant (développement, ou hébergement avec volume) :
STOCKAGE_DISQUE_RACINE="/var/lib/plombeo/documents"
#
# Stockage objet compatible S3 (hébergement sans état). Déclaré mais pas encore
# implémenté : aucun fournisseur n'est retenu à ce stade.
# STOCKAGE_S3_BUCKET="plombeo-documents"

# --- Envoi d'e-mails (Phase 7) ---------------------------------------------
# Serveur SMTP. Sans ces variables, l'envoi est REFUSÉ avec un message clair :
# jamais d'e-mail avalé en silence (§76).
SMTP_HOST="smtp.exemple.fr"
SMTP_PORT="587"
SMTP_USER="contact@exemple.fr"
SMTP_PASSWORD="mot-de-passe-applicatif"
EMAIL_EXPEDITEUR="Plombéo <contact@exemple.fr>"

# --- Balayage des automatisations ------------------------------------------
# Secret partagé du point d'entrée /api/cron/automatisations. Sans lui, la route
# est FERMÉE (503) : le défaut sûr est de ne rien faire, pas de laisser entrer.
CRON_SECRET="valeur-aleatoire-longue"

# --- Assistant IA (Phase 11) -----------------------------------------------
# Aucun fournisseur n'est retenu (décision d'architecture n°9, ouverte). Sans
# ces variables, l'assistant est INDISPONIBLE et le dit — rien n'est simulé.
#
# [À VÉRIFIER — SOURCE OFFICIELLE ET CONSEIL JURIDIQUE] Le recours à un
# fournisseur d'IA sur des données de clients suppose au minimum un accord de
# sous-traitance, la localisation des traitements et l'information des personnes.
IA_FOURNISSEUR="nom-du-fournisseur"
IA_URL="https://api.exemple.fr/v1/messages"
IA_CLE_API="cle-api"
IA_MODELE="nom-du-modele"

# --- Rotation du secret de session (Phase 15) ------------------------------
# Ancien secret, accepté EN VÉRIFICATION le temps que les sessions expirent.
# Permet une rotation sans déconnecter tout le monde. À retirer ensuite.
# SESSION_SECRET_PRECEDENT="ancien-secret"
