# --- Base de données PostgreSQL (Supabase) ---
# Dans Supabase : Project Settings > Database > Connection string > URI.
# Prenez la connexion DIRECTE (port 5432) : elle sert à la fois à l'application
# et aux migrations, c'est le plus simple. Remplacez [MOT-DE-PASSE] par le mot de
# passe de la base choisi à la création du projet Supabase.
DATABASE_URL="postgresql://postgres:[MOT-DE-PASSE]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# --- Sécurité des sessions (connexion) ---
# Chaîne aléatoire longue et secrète. Générez-en une avec :  openssl rand -base64 32
SESSION_SECRET="changez-moi-en-production"

# --- Envoi des rappels et relances par SMS/email (optionnel) ---
# Sans ces variables, les envois sont « simulés » (journalisés en base et en
# console) : l'app reste entièrement utilisable en démo, mais rien n'est
# réellement envoyé au client du garage.
# BREVO_API_KEY="xkeysib-xxxxxxxx"
# SMS_SENDER_NAME="Garage"
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Atelier Radar <notifications@votre-domaine.fr>"

# --- Agents automatiques (cron) ---
# Secret partagé protégeant les routes /api/cron/*. Sur Vercel, définissez la
# même valeur : le Cron l'enverra dans l'en-tête Authorization. Voir vercel.json.
CRON_SECRET="changez-moi-en-production"
