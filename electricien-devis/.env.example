# --- Base de données PostgreSQL (Supabase) ---
# Dans Supabase : Project Settings > Database > Connection string > URI.
# Prenez la connexion DIRECTE (port 5432) : elle sert à la fois à l'application
# et aux migrations, c'est le plus simple. Remplacez [MOT-DE-PASSE] par le mot de
# passe de la base choisi à la création du projet Supabase.
DATABASE_URL="postgresql://postgres:[MOT-DE-PASSE]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# --- Sécurité des sessions (connexion) ---
# Chaîne aléatoire longue et secrète. Générez-en une avec :  openssl rand -base64 32
SESSION_SECRET="changez-moi-en-production"
