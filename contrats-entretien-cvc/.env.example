# --- Base de données PostgreSQL ---
# Local, ou un service gratuit type Neon / Supabase / Vercel Postgres.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contrats_entretien"

# --- Sécurité des sessions (connexion) ---
# Chaîne aléatoire longue et secrète. Générez-en une avec : openssl rand -base64 32
SESSION_SECRET="changez-moi-en-production"

# --- Envoi des relances par e-mail (optionnel, fonction simulée sans clé) ---
# Sans ces variables, les messages de renouvellement restent des BROUILLONS :
# l'app génère le texte personnalisé mais ne l'envoie jamais réellement (voir
# src/lib/messages.ts et la page Renouvellements). Avec une clé Resend/Brevo et
# une adresse expéditeur vérifiée, l'envoi pourrait être branché ici.
# RESEND_API_KEY=""
# EMAIL_FROM="SuiviCVC <contrats@votre-entreprise.fr>"

# --- Envoi des relances par SMS (optionnel, fonction simulée sans clé) ---
# Sans ces variables, le SMS de renouvellement reste un brouillon copiable.
# Nécessite un fournisseur SMS (ex. Brevo, Twilio).
# SMS_API_KEY=""
# SMS_SENDER_NAME="SuiviCVC"
