# --- Supabase (production) ---------------------------------------------------
# Sans ces variables, l'app tourne en « mode démo » (données en mémoire).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « service_role » : uniquement côté serveur, ne jamais la publier.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sécurité ----------------------------------------------------------------
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 48).
SESSION_SECRET=
# Mot de passe de l'espace /admin (modération).
ADMIN_PASSWORD=
