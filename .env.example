# --- Base de données ---
# Dev local (SQLite, par défaut). En production, utiliser une base Postgres
# managée hébergée dans l'UE (ex. Supabase region eu-west) :
#   DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public"
DATABASE_URL="file:./dev.db"

# --- Sécurité ---
# Secret de signature des sessions JWT. Générer une valeur aléatoire forte :
#   openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-in-production-please-use-a-long-random-string"
