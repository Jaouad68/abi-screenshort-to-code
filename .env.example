# ---------------------------------------------------------------------------
#  Base de données — PostgreSQL (parité dev/prod)
# ---------------------------------------------------------------------------
# DÉVELOPPEMENT LOCAL (Postgres via docker-compose : `docker compose up -d`)
DATABASE_URL="postgresql://resto:resto@localhost:5432/resto_haccp?schema=public"
DIRECT_URL="postgresql://resto:resto@localhost:5432/resto_haccp?schema=public"

# PRODUCTION (Vercel + base managée hébergée dans l'UE, ex. Supabase région eu-*)
#   - DATABASE_URL : connexion POOLÉE (PgBouncer, port 6543) pour le runtime
#     serverless. Ajouter ?pgbouncer=true&connection_limit=1
#   - DIRECT_URL   : connexion DIRECTE (port 5432) utilisée pour les migrations
#
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---------------------------------------------------------------------------
#  Sécurité
# ---------------------------------------------------------------------------
# Secret de signature des sessions JWT. Générer une valeur aléatoire forte :
#   openssl rand -base64 48
AUTH_SECRET="dev-secret-change-me-in-production-please-use-a-long-random-string"
