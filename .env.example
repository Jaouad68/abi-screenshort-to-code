# PostgreSQL connection string (local dev, Neon, Vercel Postgres, Supabase...).
DATABASE_URL="postgresql://user:password@localhost:5432/resazen"
SESSION_SECRET="change-me-in-production"

# Phase 2 (SMS) — optional. Without these, SMS are only logged (Journal SMS) and
# never actually sent (see src/lib/sms/provider.ts).
# BREVO_API_KEY=
# SMS_SENDER_NAME=ResaZen

# Shared secret required by the J-2 reminder cron route (src/app/api/cron/rappels-j2).
CRON_SECRET="change-me-in-production"

# Base URL used to build the /b/[token] links sent by SMS.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Phase 3 (acompte) — optional. Without these, a required deposit is recorded as
# "due" (DEMANDE) but never actually collected online (see src/lib/paiement/provider.ts).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Phase 5 (sécurité) — optional. Without EMAIL_FROM, password-reset emails are only
# logged to the console (see src/lib/email/provider.ts). Reuses BREVO_API_KEY above.
# EMAIL_FROM=

# Shared secret required by the inbound STOP-SMS webhook (src/app/api/sms/inbound).
STOP_SMS_SECRET="change-me-in-production"

# Phase 5 (facturation) — optional. Without these, subscribing to a plan shows a
# "not configured" message instead of a real Stripe Checkout (see src/lib/facturation).
# Create one recurring Stripe Price per plan and paste its id below.
# STRIPE_PRICE_ESSENTIEL=
# STRIPE_PRICE_SERENITE=
# STRIPE_PRICE_PREMIUM=
